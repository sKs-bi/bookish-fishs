# 运行环境
NODE_ENV=development

# 服务端口
PORT=3000

# 数据库配置
# 使用SQLite（开发环境推荐）
USE_SQLITE=true

# 使用MySQL（生产环境推荐）
# USE_SQLITE=false
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=asset_management

# JWT配置
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 文件存储路径
BACKUP_PATH=./backups
UPLOAD_PATH=./uploads
